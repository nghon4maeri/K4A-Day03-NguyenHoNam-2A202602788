# ==========================================
# MULTI-PROVIDER LLM ADAPTER CONFIGURATION
# ==========================================

# Lựa chọn LLM Provider: "gemini", "openai", "anthropic", "openrouter", hoặc "mock" (offline)
LLM_PROVIDER=openai

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
# LLM_MODEL=gemini-3.6-flash

# OpenAI / OpenAI-compatible API (Fireworks AI: https://api.fireworks.ai/inference/v1)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.fireworks.ai/inference/v1
LLM_MODEL=accounts/fireworks/models/deepseek-v4-flash-0731

# Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# LLM_MODEL=claude-3-5-haiku-20241022

# MCP Configuration
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8000


